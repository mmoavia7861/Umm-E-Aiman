        },
        "adminNotes": {
          "type": "string",
          "maxLength": 1000,
          "description": "Internal admissions office review notes."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the inquiry was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest update."
        }
      },
      "required": [
        "applicantUid",
        "studentFullName",
        "guardianName",
        "phoneNumber",
        "whatsappNumber",
        "email",
        "cityOrDistrict",
        "interestedCourse",
        "matricQualification",
        "inquiryMessage",
        "consentGiven",
        "status",
        "adminNotes",
        "createdAt",
        "updatedAt"
      ]
    },
